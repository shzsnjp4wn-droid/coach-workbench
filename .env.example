# Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Public app origin used for Auth email redirects (must also be in
# Supabase → Authentication → URL Configuration → Site URL / Redirect URLs).
# Examples: http://localhost:5173  or  https://your-production-host
VITE_APP_URL=http://localhost:5173

# Also set in Supabase Dashboard → Authentication → URL Configuration:
#   Site URL     = same as VITE_APP_URL (production host when deployed)
#   Redirect URLs = http://localhost:5173/** and https://your-production-host/**

# Service role key — seed script only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
